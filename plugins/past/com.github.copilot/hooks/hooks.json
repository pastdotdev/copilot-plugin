{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "type": "command", "bash": "sh \"${PLUGIN_ROOT}/bin/past\" start", "powershell": "node \"${PLUGIN_ROOT}/bin/past-hook.mjs\" start", "timeoutSec": 8 }
    ],
    "userPromptSubmitted": [
      { "type": "command", "bash": "sh \"${PLUGIN_ROOT}/bin/past\" prompt", "powershell": "node \"${PLUGIN_ROOT}/bin/past-hook.mjs\" prompt", "timeoutSec": 6 }
    ],
    "agentStop": [
      { "type": "command", "bash": "sh \"${PLUGIN_ROOT}/bin/past\" stop", "powershell": "node \"${PLUGIN_ROOT}/bin/past-hook.mjs\" stop", "timeoutSec": 5 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "sh \"${PLUGIN_ROOT}/bin/past\" end", "powershell": "node \"${PLUGIN_ROOT}/bin/past-hook.mjs\" end", "timeoutSec": 5 }
    ]
  }
}
